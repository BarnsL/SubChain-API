# ── SubChain server ──────────────────────────────────────────────────
# SUBCHAIN_PORT=4854
# SUBCHAIN_HOST=127.0.0.1

# ── Provider credentials ─────────────────────────────────────────────
# The environment is an explicit override layer. The resolver otherwise checks
# conventional app locations and platform-native stores when available. Never
# commit this file after adding real values.

# SUBCHAIN_ANTHROPIC_OAUTH_TOKEN=
# SUBCHAIN_OPENAI_API_KEY=
# SUBCHAIN_KIMI_API_KEY=
# SUBCHAIN_GOOGLE_API_KEY=
# SUBCHAIN_ZHIPU_API_KEY=
# SUBCHAIN_SAKANA_API_KEY=

# ── Local API key ────────────────────────────────────────────────────
# Generated private keys are stored in the platform app-data directory. This
# optional value preserves an existing default key during migration.
# SUBCHAIN_ACCESS_KEY=
