# ── SubChain server ──────────────────────────────────────────────────
# SUBCHAIN_PORT=4854
# SUBCHAIN_HOST=127.0.0.1

# ── Provider credentials ─────────────────────────────────────────────
# The environment is an explicit override layer. The resolver otherwise checks
# conventional app locations and platform-native stores when available. Never
# commit this file after adding real values.

# SUBCHAIN_ANTHROPIC_OAUTH_TOKEN=
# SUBCHAIN_OPENAI_API_KEY=
# SUBCHAIN_KIMI_API_KEY=
# SUBCHAIN_GOOGLE_API_KEY=
# SUBCHAIN_ZHIPU_API_KEY=
# SUBCHAIN_SAKANA_API_KEY=
# SUBCHAIN_OPENROUTER_API_KEY=
# SUBCHAIN_GROQ_API_KEY=
# SUBCHAIN_DEEPSEEK_API_KEY=

# Dario runs locally and authenticates with a fixed placeholder token; override
# this only if your Dario install expects a different one. The real Claude
# subscription credential stays inside Dario and is never read by SubChain.
# SUBCHAIN_DARIO_API_KEY=

# A local OpenAI-compatible server usually needs no key at all. Set this only
# if yours requires one.
# SUBCHAIN_LOCAL_API_KEY=

# Optional portable private sources. These are local configuration paths, not
# credentials, and must remain outside version control.
# SUBCHAIN_CREDENTIALS_DIR=
# SUBCHAIN_CREDENTIAL_ENV_FILE=

# ── Local API key ────────────────────────────────────────────────────
# Generated private keys are stored in the platform app-data directory. This
# optional value preserves an existing default key during migration.
# SUBCHAIN_ACCESS_KEY=

# ── Operator control plane ───────────────────────────────────
# Only needed when the Chat, Logs & Doctor page is pointed at an external
# control model instead of routing through SubChain itself.
# SUBCHAIN_CONTROL_API_KEY=
